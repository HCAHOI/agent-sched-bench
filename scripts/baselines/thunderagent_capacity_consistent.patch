diff --git a/tests/check_pending_release.py b/tests/check_pending_release.py
new file mode 100644
index 0000000..3ed9c9b
--- /dev/null
+++ b/tests/check_pending_release.py
@@ -0,0 +1,101 @@
+"""Run against the patched checkout: python tests/check_pending_release.py."""
+import asyncio
+import time
+
+from ThunderAgent.backend.vllm_metrics import VLLMCacheConfig
+from ThunderAgent.program import ProgramStatus, ProgramState
+from ThunderAgent.scheduler import MultiBackendRouter
+
+
+async def check(final_tokens):
+    router = MultiBackendRouter(["http://127.0.0.1:8000"])
+    try:
+        backend = router.backends["http://127.0.0.1:8000"]
+        backend.metrics_client.cache_config = VLLMCacheConfig(16, 6250)
+        for i in range(3):
+            state = router.get_or_create_program(str(i))
+            state.backend_url = backend.url
+            state.status = ProgramStatus.REASONING
+            state.total_tokens = 35000
+            backend.register_program(state.program_id, state)
+        states = list(backend._programs.values())
+        assert backend.remaining_capacity() == -5300
+        await router._pause_until_safe(backend)
+        assert sum(s.marked_for_pause for s in states) == 1
+        assert not backend.has_capacity()  # Pending release cannot admit new work.
+        await router._pause_until_safe(backend)
+        assert sum(s.marked_for_pause for s in states) == 1
+        first = next(s for s in states if s.marked_for_pause)
+        if final_tokens == 5000:
+            router.update_program_after_request(first.program_id, first, final_tokens)
+        else:
+            router.update_program_tokens_streaming(first, 40000)
+            await router._pause_until_safe(backend)
+            assert sum(s.marked_for_pause for s in states) == 1
+        for state in states:
+            if state is not first:
+                router.update_program_tokens_streaming(state, 20000)
+        await router._pause_until_safe(backend)
+        if final_tokens != 5000:
+            assert sum(s.marked_for_pause for s in states) == 2
+            router.update_program_after_request(first.program_id, first, final_tokens)
+        await router._pause_until_safe(backend)
+        assert sum(s.marked_for_pause for s in states) == 1
+        assert backend.remaining_capacity() < 0
+        assert backend.capacity_overflow(include_future_release=True) == 0
+        for state in states:
+            if state.marked_for_pause:
+                router.update_program_after_request(state.program_id, state, state.total_tokens)
+        assert backend.active_program_count == 1
+        assert backend.remaining_capacity() >= 0
+    finally:
+        await router.stop()
+
+
+for final_tokens in (5000, 75000):
+    asyncio.run(check(final_tokens))
+
+
+async def check_decay() -> None:
+    router = MultiBackendRouter(["http://127.0.0.1:8000"], use_acting_token_decay=True)
+    try:
+        backend = router.get_default_backend()
+        backend.metrics_client.cache_config = VLLMCacheConfig(16, 6250)
+        running = router.get_or_create_program("running")
+        idle = router.get_or_create_program("idle")
+        for state, tokens in [(running, 40000), (idle, 70000)]:
+            state.backend_url = backend.url
+            state.total_tokens = tokens
+            backend.register_program(state.program_id, state)
+        idle.status = ProgramStatus.ACTING
+        idle.acting_since = time.time() - 10
+        assert backend.remaining_capacity() < 0
+        assert router._select_backend_for_new_program(20000) == backend.url
+        waiting = router.get_or_create_program("waiting")
+        waiting.total_tokens = 20000
+        waiting.step_count = 2
+        waiting.state = ProgramState.PAUSED
+        waiting.waiting_event = asyncio.Event()
+        router._add_to_global_waiting_queue_sync(waiting.program_id, waiting)
+        await router._greedy_resume()
+        assert waiting.state == ProgramState.ACTIVE
+        assert backend.capacity_overflow() == 0
+        await router._pause_until_safe(backend)
+        assert idle.state == ProgramState.ACTIVE
+        assert not any(p.marked_for_pause for p in router.programs.values())
+        # Fresh acting tokens still count: true overflow must trigger eviction.
+        idle.acting_since = time.time()
+        assert backend.capacity_overflow() > 0
+        await router._pause_until_safe(backend)
+        assert idle.state == ProgramState.PAUSED
+        assert backend.capacity_overflow() == 0
+        # Pending reasoning release also stops excess marking with decay enabled.
+        router.update_program_tokens_streaming(running, 50000)
+        await router._pause_until_safe(backend)
+        assert waiting.marked_for_pause and not running.marked_for_pause
+        assert backend.capacity_overflow(include_future_release=True) == 0
+    finally:
+        await router.stop()
+
+
+asyncio.run(check_decay())
