+@router.post("/ppd/cache_state")
+async def ppd_cache_state(raw_request: Request):
+    from fastapi import HTTPException
+
+    payload = await raw_request.json()
+    if not isinstance(payload, dict) or set(payload) != {"prompt_token_ids"}:
+        raise HTTPException(400, "Expected prompt_token_ids")
+    tokens = payload["prompt_token_ids"]
+    client = engine_client(raw_request)
+    if (not isinstance(tokens, list) or not tokens
+            or len(tokens) > client.model_config.max_model_len
+            or any(type(token) is not int or token < 0 for token in tokens)):
+        raise HTTPException(400, "Invalid prompt token IDs")
+    result = await client.engine_core.call_utility_async("ppd_cache_state", tokens)
